{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipcdj-worship-push",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://worship.ipcdj.org",
    "VAPID_SUBJECT": "https://worship.ipcdj.org/",
    "DELIVERY_BATCH_SIZE": "8"
  },
  "secrets": {
    "required": [
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "ADMIN_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ipcdj-worship-push",
      "database_id": "e474b5be-f2a9-4c19-8756-f1adb0a5ef6a"
    }
  ]
}
