{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipcdj-song-requests",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "env": {
    "staging": {
      "name": "ipcdj-song-requests-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "SITE_ORIGIN": "https://staging.worship.ipcdj.org",
        "TURNSTILE_EXPECTED_HOSTNAME": "staging.worship.ipcdj.org",
        "INGEST_ENABLED": "false",
        "MATCH_PENDING_ENABLED": "false",
        "PUBLICATION_ENABLED": "false",
        "PUBLIC_PROMO_DISPLAY_CERTIFIED": "false",
        "EMAIL_NOTIFICATIONS_ENABLED": "false",
        "EMAIL_TO": "ipcdjofficial@gmail.com",
        "EMAIL_FROM": "solicitudes@ipcdj.org",
        "MAIL_PROBE_ENABLED": "false",
        "MAIL_PROBE_ID": "ipcdj-email-probe-20261017-01"
      },
      "secrets": {
        "required": [
          "ADMIN_TOKEN",
          "TURNSTILE_SECRET",
          "IP_HASH_SALT"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ipcdj-song-requests-staging",
          "database_id": "62ecdd60-5805-402d-92aa-71269eeb6fd1"
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "send_email": [
        {
          "name": "EMAIL",
          "destination_address": "ipcdjofficial@gmail.com"
        }
      ]
    }
  }
}
